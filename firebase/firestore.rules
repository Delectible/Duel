rules_version = '2';

// Duel's Firestore rules. Players only READ: parties, games and hands are
// written by the referee (server/, a trusted service account that these
// rules don't apply to). The one thing players write is their own profile.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Your name and face, for others to see.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 14;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // A party: only its members can see it.
    match /parties/{partyId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if false;
    }

    // Party codes are looked up by the referee only.
    match /codes/{codeId} {
      allow read, write: if false;
    }

    // A game: only the players in it can see it.
    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.seats;
      allow write: if false;

      // Card games: each hand is visible to its owner only.
      match /hands/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Everything else: no.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
